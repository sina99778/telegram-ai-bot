# Telegram Bot
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
WEBHOOK_URL=https://your-domain.example.com/webhook
WEBHOOK_SECRET=change-me-to-a-random-string

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_NORMAL=gemini-3.1-flash-lite
GEMINI_MODEL_PRO=gemini-3.1-pro-preview
GEMINI_MODEL_IMAGE=gemini-3.1-flash-image-preview
# Per-feature credit costs (calibrated to real provider cost; editable via /config buttons)
NORMAL_MESSAGE_COST=1
VIP_MESSAGE_COST=15
IMAGE_CREDIT_COST=60
IMAGE_EDIT_CREDIT_COST=60
VIP_DEPLETION_BEHAVIOR=fallback_to_normal
DEFAULT_DAILY_NORMAL_CREDITS=5
VIP_DEFAULT_PLAN_NAME=vip
# Daily usage caps (conservative defaults; admins can change at runtime via /setconfig)
SEARCH_DAILY_FREE_LIMIT=1
SEARCH_DAILY_PAID_LIMIT=8
SEARCH_DAILY_VIP_LIMIT=15
SEARCH_DAILY_GROUP_LIMIT=4
FREE_DAILY_IMAGE_LIMIT=0
FREE_WEEKLY_IMAGE_EDIT_LIMIT=0
INLINE_DAILY_LIMIT=3
PRIVATE_MAX_PROMPT_LENGTH=4000
SEARCH_MAX_QUERY_LENGTH=500
IMAGE_MAX_PROMPT_LENGTH=1000
# Per-feature output token caps (cost control)
MAX_OUTPUT_TOKENS_FLASH=600
MAX_OUTPUT_TOKENS_PRO=1000
# Pay-as-you-go (token-metered) rates — credits per 1000 tokens; tunable via /setconfig
PAYG_FLASH_PER_1K=1
PAYG_PRO_PER_1K=5
PAYG_MIN_CHARGE=1
# Conversation context size — biggest input-token cost lever (tunable via /config buttons)
HISTORY_MAX_TOKENS=1200
HISTORY_MAX_MESSAGES=10
GROUP_DAILY_GROUP_CAP=40
GROUP_DAILY_USER_CAP=5

# Card-to-card payment (set live from the admin panel buttons; these are fallback defaults)
CARD_TO_CARD_NUMBER=
CARD_TO_CARD_HOLDER=
CARD_TO_CARD_NOTE=
# Toman per 1 USD for card-to-card display (0 = show USD only; admin sets via button)
USD_TOMAN_RATE=0
# Live USD→Toman auto-update (refreshes the rate above; manual rate is the fallback)
EXCHANGE_RATE_AUTO_ENABLED=true
# Fallback chain — first source that returns a sane value wins. Options: tgju, bonbast, navasan
EXCHANGE_RATE_PROVIDER=tgju,bonbast,navasan
NAVASAN_API_KEY=
EXCHANGE_RATE_UPDATE_INTERVAL_SECONDS=1800
EXCHANGE_RATE_MIN_TOMAN=20000
EXCHANGE_RATE_MAX_TOMAN=500000
GROUP_USER_COOLDOWN_SECONDS=15
GROUP_RESPONSE_TIMEOUT_SECONDS=45
GROUP_MAX_PROMPT_LENGTH=1000
PRIVATE_MESSAGE_BURST_LIMIT=6
PRIVATE_MESSAGE_BURST_WINDOW_SECONDS=30
SEARCH_COMMAND_COOLDOWN_SECONDS=10
IMAGE_COMMAND_COOLDOWN_SECONDS=20
CALLBACK_COOLDOWN_SECONDS=1
ADMIN_ACTION_COOLDOWN_SECONDS=2
ABUSE_FAILURE_WINDOW_SECONDS=600
ABUSE_FAILURE_THRESHOLD=5
ABUSE_TEMP_BLOCK_SECONDS=600
USER_ANOMALY_WINDOW_SECONDS=300
USER_ANOMALY_REQUEST_THRESHOLD=30
GROUP_ANOMALY_WINDOW_SECONDS=300
GROUP_ANOMALY_REQUEST_THRESHOLD=40
EXPENSIVE_COMMAND_BURST_WINDOW_SECONDS=180
EXPENSIVE_COMMAND_BURST_THRESHOLD=4
CALLBACK_SPAM_WINDOW_SECONDS=60
CALLBACK_SPAM_THRESHOLD=25
ANOMALY_CONTAIN_SECONDS=1800
FEATURE_CONTAIN_SECONDS=900
WEBHOOK_MAX_BODY_BYTES=262144
NOWPAYMENTS_WEBHOOK_MAX_BODY_BYTES=131072
FORCED_JOIN_REQUIRED=false
FORCED_JOIN_CHANNEL=@yourchannel
BROADCAST_BATCH_SIZE=25
BROADCAST_BATCH_PAUSE_SECONDS=1.5
BROADCAST_FAILURE_THRESHOLD=50
BROADCAST_MAX_RECIPIENTS=5000
BACKUP_ENABLED=true
# Full backup every N hours (sent to BACKUP_RECIPIENT_TELEGRAM_ID)
BACKUP_INTERVAL_HOURS=12
# Delete the local .sql.gz after a successful send so the server disk never fills
BACKUP_DELETE_AFTER_SEND=true
BACKUP_SCHEDULE_TIME=03:00
BACKUP_TIMEZONE=Europe/Berlin
# Only caps leftovers from FAILED sends (successful ones are deleted)
BACKUP_RETENTION_COUNT=3
BACKUP_DIRECTORY=./backups
BACKUP_RECIPIENT_TELEGRAM_ID=123456789
BACKUP_PGDUMP_PATH=pg_dump
BACKUP_CHECK_INTERVAL_SECONDS=60
BACKUP_LOCK_SECONDS=3600

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=gemini_bot_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Admin
# Comma-separated Telegram user IDs that should see the admin shortcut and pass admin checks
ADMIN_IDS=123456789

# Payments
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
